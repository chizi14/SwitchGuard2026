# SwitchGuard Environment Variables
# Copy this file to .env and adjust values as needed

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://switchguard:switchguard_secret@db:5432/switchguard
POSTGRES_USER=switchguard
POSTGRES_PASSWORD=switchguard_secret
POSTGRES_DB=switchguard

# JWT
JWT_SECRET=change-me-to-a-random-secret-in-production
JWT_EXPIRY_MINUTES=60

# Reversal Engine
REVERSAL_AUTO_THRESHOLD_MWK=100000

# Africa's Talking (placeholder — swap real keys for live SMS)
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=atsk_sandbox_key
AFRICASTALKING_SHORTCODE=38446

# App
APP_ENV=development
BACKEND_PORT=8000
